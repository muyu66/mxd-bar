// mxd-bar.exe 资源：应用图标 + Windows 版本信息(2.0.0)。
// 值只用 ASCII：.rc 无转义处理，中文需按代码页存，避免乱码。
1 ICON "app.ico"

1 VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040904b0"
    {
      VALUE "CompanyName", "zhuzhu"
      VALUE "FileDescription", "mxd-bar"
      VALUE "FileVersion", "2.4.0"
      VALUE "InternalName", "mxd-bar"
      VALUE "LegalCopyright", ""
      VALUE "OriginalFilename", "mxd-bar.exe"
      VALUE "ProductName", "mxd-bar"
      VALUE "ProductVersion", "2.4.0"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x0409, 1200
  }
}
